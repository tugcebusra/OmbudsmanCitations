<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0.1" class="in-text" default-locale="tr-TR">
  <info>
    <title>Ombudsman Akademik Dergisi</title>
    <id>http://www.zotero.org/styles/ombudsman-akademik-dergisi-mendeley-valid</id>
    <link href="http://www.zotero.org/styles/ombudsman-akademik-dergisi-mendeley-valid" rel="self"/>
    <category citation-format="author-date"/>
    <updated>2026-07-29T08:50:00+03:00</updated>
  </info>

  <locale xml:lang="tr-TR">
    <terms>
      <term name="and">ve</term>
      <term name="et-al">vd.</term>
      <term name="page" form="short">
        <single>s.</single>
        <multiple>ss.</multiple>
      </term>
    </terms>
  </locale>

  <macro name="author-citation">
    <names variable="author">
      <name form="short" and="text" delimiter=", " delimiter-precedes-last="never" et-al-min="3" et-al-use-first="1"/>
      <substitute>
        <names variable="editor"/>
        <text variable="publisher"/>
        <text variable="title" form="short"/>
      </substitute>
    </names>
  </macro>

  <macro name="author-bibliography">
    <names variable="author">
      <name initialize="false" name-as-sort-order="all" sort-separator=", " and="text" delimiter=", " delimiter-precedes-last="never">
        <name-part name="family" text-case="uppercase"/>
        <name-part name="given"/>
      </name>
      <substitute>
        <names variable="editor">
          <name initialize="false" name-as-sort-order="all" sort-separator=", " and="text" delimiter=", " delimiter-precedes-last="never">
            <name-part name="family" text-case="uppercase"/>
            <name-part name="given"/>
          </name>
        </names>
        <text variable="publisher" text-case="uppercase"/>
        <text variable="title" text-case="uppercase"/>
      </substitute>
    </names>
  </macro>

  <macro name="issued-year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="accessed-date">
    <date variable="accessed" delimiter=".">
      <date-part name="day" form="numeric-leading-zeros"/>
      <date-part name="month" form="numeric-leading-zeros"/>
      <date-part name="year"/>
    </date>
  </macro>

  <citation disambiguate-add-year-suffix="true">
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <text macro="author-citation"/>
        <group delimiter=": ">
          <text macro="issued-year"/>
          <text variable="locator"/>
        </group>
      </group>
    </layout>
  </citation>

  <bibliography hanging-indent="true" entry-spacing="0" line-spacing="1">
    <sort>
      <key macro="author-bibliography"/>
      <key variable="issued" sort="descending"/>
      <key variable="title"/>
    </sort>
    <layout suffix=".">
      <text macro="author-bibliography" suffix=" "/>
      <text macro="issued-year" prefix="(" suffix="). "/>
      <choose>
        <if type="article-journal article-magazine article-newspaper" match="any">
          <text variable="title" prefix="“" suffix="”"/>
          <group prefix=", " delimiter=", ">
            <text variable="container-title" font-weight="bold"/>
            <text variable="volume" prefix="Cilt: "/>
            <text variable="issue" prefix="Sayı: "/>
            <text variable="page" prefix="ss. "/>
          </group>
        </if>
        <else-if type="thesis">
          <text variable="title" font-weight="bold"/>
          <group prefix=", " delimiter=", ">
            <text variable="genre"/>
            <text variable="publisher"/>
            <text variable="publisher-place"/>
          </group>
        </else-if>
        <else-if type="webpage post-weblog" match="any">
          <text variable="title" prefix="“" suffix="”"/>
          <text variable="URL" prefix=", "/>
          <group prefix=" (" suffix=")" delimiter=": ">
            <text value="Erişim Tarihi"/>
            <text macro="accessed-date"/>
          </group>
        </else-if>
        <else>
          <text variable="title" font-weight="bold"/>
          <group prefix=", " delimiter=", ">
            <text variable="publisher"/>
            <text variable="edition" suffix=". Baskı"/>
            <text variable="publisher-place"/>
          </group>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
