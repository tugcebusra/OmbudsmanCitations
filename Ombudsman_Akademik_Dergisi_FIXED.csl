<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0.1" class="in-text" default-locale="tr-TR" demote-non-dropping-particle="sort-only">
  <info>
    <title>Ombudsman Akademik Dergisi - Özel</title>
    <title-short>Ombudsman Akademik</title-short>
    <id>http://www.zotero.org/styles/ombudsman-akademik-dergisi-ozel</id>
    <link href="http://www.zotero.org/styles/ombudsman-akademik-dergisi-ozel" rel="self"/>
    <category citation-format="author-date"/>
    <summary>Ombudsman Akademik Dergisi yazım kurallarına uyarlanmış Türkçe yazar-tarih stili.</summary>
    <updated>2026-07-29T08:55:00+03:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>

  <locale xml:lang="tr-TR">
    <terms>
      <term name="and">ve</term>
      <term name="et-al">vd.</term>
    </terms>
  </locale>

  <macro name="author-citation">
    <names variable="author">
      <name form="short" and="text" delimiter=", " delimiter-precedes-last="never" et-al-min="3" et-al-use-first="1"/>
      <substitute>
        <names variable="editor">
          <name form="short" and="text" delimiter=", " delimiter-precedes-last="never" et-al-min="3" et-al-use-first="1"/>
        </names>
        <text variable="publisher"/>
        <text variable="title" form="short"/>
      </substitute>
    </names>
  </macro>

  <macro name="author-bibliography">
    <names variable="author">
      <name initialize="false" name-as-sort-order="all" sort-separator=", " and="text" delimiter=", " delimiter-precedes-last="never">
        <name-part name="family" text-case="uppercase"/>
        <name-part name="given"/>
      </name>
      <substitute>
        <names variable="editor">
          <name initialize="false" name-as-sort-order="all" sort-separator=", " and="text" delimiter=", " delimiter-precedes-last="never">
            <name-part name="family" text-case="uppercase"/>
            <name-part name="given"/>
          </name>
        </names>
        <text variable="publisher" text-case="uppercase"/>
        <text variable="title" text-case="uppercase"/>
      </substitute>
    </names>
  </macro>

  <macro name="year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="full-date">
    <date variable="issued" delimiter=" ">
      <date-part name="day"/>
      <date-part name="month" form="long"/>
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="accessed-date">
    <date variable="accessed" delimiter=".">
      <date-part name="day" form="numeric-leading-zeros"/>
      <date-part name="month" form="numeric-leading-zeros"/>
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="edition">
    <choose>
      <if variable="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <text value="Baskı"/>
        </group>
      </if>
    </choose>
  </macro>

  <macro name="pages">
    <choose>
      <if variable="page">
        <group delimiter=" ">
          <label variable="page" form="short"/>
          <text variable="page"/>
        </group>
      </if>
    </choose>
  </macro>

  <macro name="translator">
    <names variable="translator" prefix="Çev. ">
      <name initialize="false" and="text" delimiter=", " delimiter-precedes-last="never"/>
    </names>
  </macro>

  <citation disambiguate-add-year-suffix="true" collapse="year-suffix">
    <sort>
      <key macro="author-citation"/>
      <key macro="year"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <text macro="author-citation"/>
        <group delimiter=": ">
          <text macro="year"/>
          <text variable="locator"/>
        </group>
      </group>
    </layout>
  </citation>

  <bibliography hanging-indent="true" entry-spacing="0" line-spacing="1" et-al-min="999" et-al-use-first="999">
    <sort>
      <key macro="author-bibliography"/>
      <key macro="year" sort="descending"/>
      <key variable="title"/>
    </sort>
    <layout suffix=".">
      <text macro="author-bibliography" suffix=" "/>
      <text macro="year" prefix="(" suffix="). "/>
      <choose>
        <if type="book" match="any">
          <text variable="title" font-weight="bold"/>
          <text macro="translator" prefix=", "/>
          <group prefix=", " delimiter=", ">
            <text variable="publisher"/>
            <text macro="edition"/>
            <text variable="publisher-place"/>
          </group>
        </if>

        <else-if type="chapter paper-conference entry-encyclopedia entry-dictionary" match="any">
          <text variable="title" prefix="“" suffix="”"/>
          <group prefix=", " delimiter=", ">
            <names variable="editor" prefix="Editör: ">
              <name initialize="false" and="text" delimiter=", " delimiter-precedes-last="never"/>
            </names>
            <text variable="container-title" font-weight="bold"/>
            <text variable="publisher"/>
            <text variable="publisher-place"/>
            <text macro="pages"/>
          </group>
        </else-if>

        <else-if type="article-journal article-magazine" match="any">
          <text variable="title" prefix="“" suffix="”"/>
          <group prefix=", " delimiter=", ">
            <text variable="container-title" font-weight="bold"/>
            <text variable="publisher"/>
            <group delimiter=": ">
              <text value="Cilt"/>
              <text variable="volume"/>
            </group>
            <group delimiter=": ">
              <text value="Sayı"/>
              <text variable="issue"/>
            </group>
            <text macro="pages"/>
          </group>
        </else-if>

        <else-if type="article-newspaper">
          <text variable="title" prefix="“" suffix="”"/>
          <group prefix=", " delimiter=", ">
            <text variable="container-title" font-weight="bold"/>
            <text macro="full-date"/>
            <text macro="pages"/>
          </group>
        </else-if>

        <else-if type="thesis">
          <text variable="title" font-weight="bold"/>
          <group prefix=", " delimiter=", ">
            <text variable="genre"/>
            <text variable="publisher"/>
            <text variable="publisher-place"/>
          </group>
        </else-if>

        <else-if type="report">
          <text variable="title" font-weight="bold"/>
          <group prefix=", " delimiter=", ">
            <text variable="publisher"/>
            <text variable="publisher-place"/>
          </group>
        </else-if>

        <else-if type="webpage post-weblog" match="any">
          <text variable="title" prefix="“" suffix="”"/>
          <text variable="URL" prefix=", "/>
          <group prefix=" (" suffix=")" delimiter=": ">
            <text value="Erişim Tarihi"/>
            <text macro="accessed-date"/>
          </group>
        </else-if>

        <else>
          <text variable="title" font-weight="bold"/>
          <group prefix=", " delimiter=", ">
            <text variable="container-title" font-weight="bold"/>
            <text variable="publisher"/>
            <text variable="publisher-place"/>
          </group>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
